# Copy to .env. Replace these development-only values for your machine.
NODE_ENV=development
# Optional synthetic embedded demo only; false uses DATABASE_URL and PostgreSQL.
SWEETY_LOCAL_DEMO=false
PORT=3000
DATABASE_URL=postgresql://sweety:change-me-local-only@localhost:5432/sweety
# Set this to run integration tests against a real, separate PostgreSQL test DB.
# The database name MUST end in _test; never point this at a database with real data.
TEST_DATABASE_URL=
APP_TIMEZONE=Asia/Kolkata
# Optional if frontend and API use the same origin (the default).
APP_ORIGIN=
# Use true behind HTTPS in production. false is for local HTTP only.
COOKIE_SECURE=false
# Set to 1 only when you control the one reverse proxy in front of the app.
TRUST_PROXY=0
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Synthetic seed account only. Change these before running db:seed.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=change-me-demo-password
DEMO_NAME=Alex Morgan
# Docker Compose database settings. Keep in sync with DATABASE_URL for local use.
POSTGRES_USER=sweety
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sweety
