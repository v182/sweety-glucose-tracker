{
  "name": "sweety-glucose-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "format": "prettier --write client/src client/index.html client/vite.config.js server shared scripts docs README.md package.json",
    "format:check": "prettier --check client/src client/index.html client/vite.config.js server shared scripts docs README.md package.json",
    "preview:demo": "node --env-file-if-exists=.env scripts/preview-demo.mjs",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/src/db/seed.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --env-file-if-exists=.env --test --test-concurrency=1 server/test/*.test.js",
    "test:client": "vitest run --config client/vite.config.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
