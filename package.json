{
  "name": "sweety-glucose-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/src/index.js",
    "preview:demo": "node --env-file-if-exists=.env scripts/preview-demo.mjs",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/src/db/seed.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --env-file-if-exists=.env --test --test-concurrency=1 server/test/*.test.js",
    "test:client": "vitest run --config client/vite.config.js",
    "check": "npm test && npm run build"
  }
}
